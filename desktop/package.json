{
  "name": "@tapioca/desktop",
  "version": "0.11.0",
  "private": true,
  "description": "Tapioca desktop application",
  "author": "Kyndlo",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "sidecar:build": "node --experimental-strip-types scripts/build-sidecar.ts",
    "predev": "npm run sidecar:build",
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"vite build --config vite.main.config.ts --watch\" \"vite build --config vite.preload.config.ts --watch\" \"wait-on tcp:5173 file:dist-electron/main.js file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js\"",
    "prebuild": "npm run sidecar:build",
    "build": "vite build && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "runtime:prepare": "node --experimental-strip-types scripts/prepare-runtime.ts",
    "package": "npm run build && npm run runtime:prepare && node --experimental-strip-types scripts/verify-runtime.ts && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "electron dist-electron/main.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "@types/node": "22.13.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "jsdom": "26.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "wait-on": "8.0.2",
    "zod": "3.24.2"
  },
  "build": {
    "appId": "cc.rootfruit.tapioca",
    "productName": "Tapioca",
    "executableName": "tapioca",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "sidecar",
        "filter": [
          "tapioca-control",
          "tapioca-control.exe",
          "tapioca",
          "tapioca.exe"
        ]
      },
      {
        "from": "runtime/llama.cpp",
        "to": "sidecar/runtime/llama.cpp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/tapioca-logo.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/tapioca-logo.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "public/tapioca-logo.png",
      "category": "Development"
    }
  }
}
